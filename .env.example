# Profilo: development (default), test, production (avvio ancora bloccato).
LINEA_ENV=development
# Copia in .env; non distribuire .env. Percorsi relativi alla radice del progetto.
LINEA_HOST=127.0.0.1
LINEA_PORT=8765
# Lascia vuoto per derivarlo da host/porta.
LINEA_BASE_URL=
LINEA_DATA_DIR=var/data
LINEA_SECRETS_DIR=var/secrets
LINEA_LOG_DIR=var/logs
LINEA_CACHE_DIR=var/cache
LINEA_TEMP_DIR=var/tmp
LINEA_BACKUP_DIR=var/backups
# Vuoto: nuovo archivio var/data oppure compatibilità con archivio storico.
LINEA_DATABASE=
LINEA_OLLAMA_URL=http://127.0.0.1:11434
LINEA_MODEL=qwen2.5:7b
LINEA_MODEL_CONFIG=outputs/mio-agente-ai/config/modello.json
# Facoltativo, percorso a file riservato con host/port/username/password/sender.
LINEA_SMTP_FILE=
LINEA_SMTP_HOST=
LINEA_SMTP_PORT=587
LINEA_SMTP_USER=
LINEA_SMTP_PASSWORD=
LINEA_SMTP_SENDER=
# Non esiste una secret key applicativa: sessioni casuali hashate nel database.
# OAuth storico: credentials.json e token.json nella directory dei segreti.
# API key CRM/WhatsApp non previste: connettori ancora mock.

# Integrazione Google storica, facoltativa; nessun identificativo personale incluso.
LINEA_GOOGLE_SHEET_ID=
LINEA_GOOGLE_WORKSHEET=Foglio1
# Certificato CA personalizzato solo se necessario; vuoto usa il sistema.
LINEA_CA_FILE=

# Solo webhook mock locale: segreto casuale di almeno 32 caratteri; vuoto disabilita.
LINEA_PAYMENT_WEBHOOK_SECRET=

# Backend Netlify online (nessun segreto in questo file)
# In Netlify GEMINI_API_KEY e GOOGLE_GEMINI_BASE_URL sono iniettate dal gateway.
# Non copiarle nel frontend e non impostare chiavi di fornitori diversi per errore.
LINEA_AI_MODEL=gemini-2.5-flash-lite
# Limite richieste giornaliere globale, persistente nel database.
LINEA_AI_DAILY_LIMIT=20
