# Profilo: development (default), test, production (avvio ancora bloccato).
LINEA_ENV=development
# Copia in .env; non distribuire .env. Percorsi relativi alla radice del progetto.
LINEA_HOST=127.0.0.1
LINEA_PORT=8765
# Lascia vuoto per derivarlo da host/porta.
LINEA_BASE_URL=
LINEA_DATA_DIR=var/data
LINEA_SECRETS_DIR=var/secrets
LINEA_LOG_DIR=var/logs
LINEA_CACHE_DIR=var/cache
LINEA_TEMP_DIR=var/tmp
LINEA_BACKUP_DIR=var/backups
# Vuoto: nuovo archivio var/data oppure compatibilità con archivio storico.
LINEA_DATABASE=
LINEA_OLLAMA_URL=http://127.0.0.1:11434
LINEA_MODEL=qwen2.5:7b
LINEA_MODEL_CONFIG=outputs/mio-agente-ai/config/modello.json
# Facoltativo, percorso a file riservato con host/port/username/password/sender.
LINEA_SMTP_FILE=
LINEA_SMTP_HOST=
LINEA_SMTP_PORT=587
LINEA_SMTP_USER=
LINEA_SMTP_PASSWORD=
LINEA_SMTP_SENDER=
# Non esiste una secret key applicativa: sessioni casuali hashate nel database.
# OAuth storico: credentials.json e token.json nella directory dei segreti.
# API key CRM/WhatsApp non previste: connettori ancora mock.

# Integrazione Google storica, facoltativa; nessun identificativo personale incluso.
LINEA_GOOGLE_SHEET_ID=
LINEA_GOOGLE_WORKSHEET=Foglio1
# Certificato CA personalizzato solo se necessario; vuoto usa il sistema.
LINEA_CA_FILE=

# Solo webhook mock locale: segreto casuale di almeno 32 caratteri; vuoto disabilita.
LINEA_PAYMENT_WEBHOOK_SECRET=

# Backend Netlify online (nessun segreto in questo file)
# Database: PostgreSQL su Supabase (regione Frankfurt). Solo backend.
# In Netlify: Transaction pooler (porta 6543) e contenuto PEM del certificato CA.
LINEA_DATABASE_URL=
LINEA_DATABASE_CA=
# Connessioni per istanza della Function (default 3).
LINEA_DATABASE_POOL_MAX=3
# Solo sul Mac, in .env.supabase (ignorato da Git) per npm run db:*:
# LINEA_DATABASE_MIGRATION_URL=<Session pooler, porta 5432>
# LINEA_DATABASE_CA_FILE=<percorso del certificato CA>
# AI: Gemini API diretta tramite adapter (netlify/lib/ai/). La chiave va impostata
# SOLO in Netlify → Environment variables (scope Functions, valore segreto).
# Non usare GEMINI_API_KEY/GOOGLE_GEMINI_BASE_URL dell'AI Gateway: sono ignorate.
# Provider: gemini (predefinito) oppure ollama (riserva).
LINEA_AI_PROVIDER=gemini
LINEA_GEMINI_API_KEY=
LINEA_AI_MODEL=gemini-3.5-flash-lite
# Riserva Ollama Cloud, usata solo con LINEA_AI_PROVIDER=ollama (senza ricerca web).
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Facoltativo, solo HTTPS; vuoto = https://ollama.com
OLLAMA_BASE_URL=
# Facoltativo: modello per la ricerca aziendale nel provider attivo.
LINEA_RESEARCH_MODEL=
# URL pubblico del sito per i link nelle email (es. https://linea-ai.it); vuoto = origine della richiesta.
PUBLIC_SITE_URL=
# Tetto giornaliero globale di chiamate chat (protezione costi, tutte le aziende).
LINEA_AI_DAILY_LIMIT=20
# Anti-raffica per azienda (messaggi al minuto).
LINEA_AI_COMPANY_PER_MINUTE=30
# Quota mensile della chat pubblica Servizi Linea AI (tenant demo).
LINEA_PUBLIC_DEMO_MONTHLY_LIMIT=1000
# Segreto casuale (>= 32 caratteri) per le chiamate interne alle background function.
LINEA_INTERNAL_SECRET=
